  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tellescope/constants": "2.0.0-beta.0",
    "@tellescope/types-client": "2.0.0-beta.0",
    "@tellescope/types-models": "2.0.0-beta.0",
    "@tellescope/types-server": "2.0.0-beta.0",
    "@tellescope/types-utilities": "2.0.0-beta.0",
    "@tellescope/utilities": "2.0.0-beta.0",
