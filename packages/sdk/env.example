# SDK test credentials. Generate with `npm run setup-env` then `npm run bootstrap` at the repo root,
# or copy this file to .env (gitignored) and fill the blanks. Tests load it with
# `node -r dotenv/config lib/cjs/tests/api_tests/<name>.test.js` from this directory.
# (Named env.example rather than .env.example so the repo's Claude deny rules on *.env.* do not block
#  agents from reading or maintaining this template.)

# The API under test.
API_URL=http://localhost:8080

# ── Written by `npm run bootstrap` ───────────────────────────────────────────────────────────────
# A tenant provisioned through the API's test-support endpoints: an Admin, a Non-Admin and one API key.
TEST_EMAIL=
TEST_PASSWORD=
NON_ADMIN_EMAIL=
NON_ADMIN_PASSWORD=
TEST_BUSINESS_ID=
# The tenant's subdomain. The front-end regression suite (packages/private/e2e) points the portal at it
# (?overrideSubdomain=) so the portal resolves this tenant, not whichever organization claims the local
# portal origin as its customPortalURL. E2E_PORTAL_SUBDOMAIN still overrides it.
TEST_SUBDOMAIN=
TEST_API_KEY=
# "true" when the tenant above came from bootstrap; the fixture then resets only that tenant.
TEST_TENANT_PROVISIONED=

# Staging only: the test-support endpoints require the API's SERVICES_SECRET there.
# SERVICES_SECRET=

# ── Legacy shared-fixture tests only ─────────────────────────────────────────────────────────────
# A handful of suites still expect hand-seeded accounts in the shared test organization. Leave unset
# unless you are running those against a copy of that database.
# TEST_EMAIL_2=
# TEST_PASSWORD_2=
# SUB_EMAIL=
# SUB_SUB_EMAIL=
# OTHER_SUB_EMAIL=
# MFA_EMAIL=
# CROSS_ORG_API_KEY=
# CROSS_ORG_TARGET_BUSINESS_ID=
# CROSS_ORG_UNAPPROVED_BUSINESS_ID=
